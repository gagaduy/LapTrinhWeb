@model IEnumerable<Buoi6.Models.Product>

@{
    ViewData["Title"] = "Trang chủ";
}

<div class="hero-band-modern">
    <div class="container">
        <h1 class="typography-hero-display mb-3">Thế giới công nghệ</h1>
        <p class="typography-subtitle mb-4 mx-auto" style="max-width: 600px;">
            Khám phá những sản phẩm mới nhất, tối giản nhưng mạnh mẽ. Đưa trải nghiệm của bạn lên tầm cao mới.
        </p>
    </div>
</div>

<div class="container my-5 pb-5">
    <div class="row gx-5">
        <!-- Sidebar Danh mục -->
        <div class="col-lg-3 col-md-4 mb-4">
            <div class="sticky-top" style="top: 100px;">
                <h3 class="typography-heading-4 mb-3 ps-3">Danh mục</h3>
                <div class="d-flex flex-column gap-1">
                    <a asp-controller="Home" asp-action="Index" class="nav-link-notion @(ViewBag.CurrentCategory == null ? "bg-light fw-bold" : "")">Tất cả sản phẩm</a>
                    @if (ViewBag.Categories != null)
                    {
                        foreach (var category in ViewBag.Categories)
                        {
                            <a asp-controller="Home" asp-action="Index" asp-route-categoryId="@category.Id" class="nav-link-notion">@category.Name</a>
                        }
                    }
                </div>
            </div>
        </div>

        <!-- Lưới Sản phẩm -->
        <div class="col-lg-9 col-md-8">
            <div class="row g-4">
                @foreach (var item in Model)
                {
                    <div class="col-xl-4 col-md-6">
                        <div class="card-product">
                            <a asp-controller="Home" asp-action="ProductDetail" asp-route-id="@item.Id" class="card-product-img-wrapper text-decoration-none">
                                <img src="@item.ImageUrl" class="card-product-img" alt="@item.Name" onerror="this.src='https://via.placeholder.com/400x300?text=No+Image'">
                            </a>
                            <div class="card-product-body">
                                <div class="mb-2">
                                    <span class="badge" style="background: var(--color-card-tint-sky); color: var(--color-ink-deep); font-weight: 500;">@item.Category?.Name</span>
                                </div>
                                <a asp-controller="Home" asp-action="ProductDetail" asp-route-id="@item.Id" class="text-decoration-none" style="color: var(--color-ink-deep);">
                                    <h5 class="typography-heading-4 mb-1">@item.Name</h5>
                                </a>
                                <div class="mt-auto pt-3 d-flex justify-content-between align-items-center border-top" style="border-color: var(--color-hairline) !important;">
                                    <span class="typography-body-md" style="color: var(--color-brand-orange-deep); font-size: 16px;">
                                        @item.Price.ToString("N0")₫
                                    </span>
                                    <a asp-controller="Home" asp-action="ProductDetail" asp-route-id="@item.Id" class="button-primary py-1 px-3" style="font-size: 13px;">Chi tiết</a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
                @if(!Model.Any())
                {
                    <div class="col-12 text-center py-5">
                        <div class="p-5 bg-white rounded border">
                            <h4 class="typography-heading-4" style="color: var(--color-slate)">Chưa có sản phẩm nào.</h4>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
