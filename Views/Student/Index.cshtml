@{
    ViewData["Title"] = "Đăng ký chuyên ngành";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

<style>
    .premium-card {
        background: var(--card-bg);
        border: 1px solid var(--border-color);
        border-radius: 24px;
        box-shadow: var(--shadow-lg);
        overflow: hidden;
        transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .premium-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 25px 50px -12px rgba(79, 70, 229, 0.15);
    }

    .card-header-premium {
        background: white;
        padding: 3rem 2rem 2rem;
        text-align: center;
        border-bottom: 1px solid #f1f5f9;
    }

    .icon-wrapper {
        width: 64px;
        height: 64px;
        background: #eef2ff;
        color: var(--primary);
        border-radius: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 1.5rem;
        font-size: 1.75rem;
        box-shadow: inset 0 2px 4px 0 rgba(0, 0, 0, 0.05);
    }

    .form-label {
        font-weight: 600;
        font-size: 0.9rem;
        color: var(--text-muted);
        margin-bottom: 0.5rem;
        text-transform: uppercase;
        letter-spacing: 0.025em;
    }

    .form-control, .form-select {
        background: #f8fafc;
        border: 2px solid #f1f5f9;
        color: var(--text-main);
        border-radius: 12px;
        padding: 0.875rem 1.25rem;
        transition: all 0.3s ease;
        font-weight: 500;
    }

    .form-control:focus, .form-select:focus {
        background: white;
        border-color: var(--primary);
        box-shadow: 0 0 0 4px rgba(79, 70, 229, 0.1);
        color: var(--text-main);
    }

    .btn-submit-premium {
        background: var(--primary);
        color: white;
        border: none;
        border-radius: 12px;
        padding: 1rem;
        font-weight: 700;
        letter-spacing: 0.5px;
        transition: all 0.3s ease;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.75rem;
        box-shadow: 0 4px 6px -1px rgba(79, 70, 229, 0.4);
    }

    .btn-submit-premium:hover {
        background: var(--primary-hover);
        transform: scale(1.02);
        box-shadow: 0 10px 15px -3px rgba(79, 70, 229, 0.5);
        color: white;
    }

    .btn-submit-premium:active {
        transform: scale(0.98);
    }

    .accent-text {
        color: var(--primary);
        font-weight: 700;
    }
</style>

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-5 col-md-8">
            <div class="premium-card">
                <div class="card-header-premium">
                    <div class="icon-wrapper">
                        <i class="bi bi-mortarboard-fill"></i>
                    </div>
                    <h2 class="h3 fw-bold mb-1" style="color: #0f172a;">Đăng Ký Chuyên Ngành</h2>
                    <p class="text-muted mb-0">Khoa <span class="accent-text">Công Nghệ Thông Tin</span></p>
                </div>
                
                <div class="card-body p-4 p-md-5">
                    <form method="post" asp-action="ShowKQ">
                        <div class="mb-4">
                            <label for="MSSV" class="form-label">Mã Số Sinh Viên</label>
                            <input type="text" id="MSSV" name="MSSV" class="form-control" required placeholder="Ví dụ: 21110xxx" />
                        </div>
                        
                        <div class="mb-4">
                            <label for="HoTen" class="form-label">Họ và Tên</label>
                            <input type="text" id="HoTen" name="HoTen" class="form-control" required placeholder="Nhập đầy đủ họ tên" />
                        </div>
                        
                        <div class="mb-4">
                            <label for="DiemTB" class="form-label">Điểm Trung Bình</label>
                            <input type="number" step="0.1" min="0" max="10" id="DiemTB" name="DiemTB" class="form-control" required placeholder="0.0 - 10.0" />
                        </div>
                        
                        <div class="mb-5">
                            <label for="ChuyenNganh" class="form-label">Chuyên Ngành Mong Muốn</label>
                            <select id="ChuyenNganh" name="ChuyenNganh" class="form-select">
                                <option value="CNPM">Công nghệ phần mềm (CNPM)</option>
                                <option value="HTTT">Hệ thống thông tin (HTTT)</option>
                                <option value="ANM">An ninh mạng (ANM)</option>
                                <option value="TTNT">Trí tuệ nhân tạo (TTNT)</option>
                                <option value="MMT">Mạng máy tính (MMT)</option>
                            </select>
                        </div>
                        
                        <div class="d-grid">
                            <button type="submit" class="btn btn-submit-premium">
                                <i class="bi bi-send-check-fill"></i> Gửi Đăng Ký Ngay
                            </button>
                        </div>
                    </form>
                </div>
            </div>
            <p class="text-center mt-4 text-muted small">
                © 2026 Student Registration System. All rights reserved.
            </p>
        </div>
    </div>
</div>

