@model KiemTraGiuaKy.ViewModels.Enrollments.MyCoursesViewModel
@{
    ViewData["Title"] = "My Courses";
}

<section class="mb-4">
    <p class="course-kicker small mb-1">Student</p>
    <h1 class="display-6 fw-semibold mb-1">My Courses</h1>
    <p class="course-subtitle mb-0">Danh sach hoc phan ban da dang ky.</p>
</section>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success">@successMessage</div>
}

@if (TempData["ErrorMessage"] is string errorMessage)
{
    <div class="alert alert-danger">@errorMessage</div>
}

<div class="row g-4">
    @foreach (var course in Model.Courses)
    {
        <div class="col-md-6 col-xl-4">
            <article class="card h-100 shadow-sm border-0 course-card">
                <img src="@course.Image" class="card-img-top course-image" alt="@course.Name" />
                <div class="card-body d-flex flex-column">
                    <span class="badge course-category-badge align-self-start">@course.CategoryName</span>
                    <h2 class="h5 mt-3 mb-1 course-title">@course.Name</h2>
                    <p class="course-lecturer">Giang vien: <strong>@course.Lecturer</strong></p>
                    <p><span class="badge course-credit-badge">@course.Credits tin chi</span></p>
                    <form asp-action="Delete" asp-route-courseId="@course.Id" method="post" class="mt-auto">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-outline-danger w-100">Huy dang ky</button>
                    </form>
                </div>
            </article>
        </div>
    }
</div>

@if (!Model.Courses.Any())
{
    <div class="alert alert-info mb-0">Ban chua dang ky hoc phan nao.</div>
}
