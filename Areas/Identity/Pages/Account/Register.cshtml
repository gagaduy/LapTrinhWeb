@page
@model RegisterModel
@{
    ViewData["Title"] = "Đăng ký";
}

<div class="d-flex justify-content-center align-items-center mt-5 mb-5">
    <div class="card-base w-100" style="max-width: 400px; padding: 40px;">
        <div class="text-center mb-4">
            <h1 class="typography-heading-2 mb-2">Tạo tài khoản</h1>
            <p class="typography-body-sm text-slate">Đăng ký để trải nghiệm dịch vụ</p>
        </div>
        
        <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>
            
            <div class="mb-3">
                <label asp-for="Input.Email" class="typography-body-sm-medium mb-1 d-block text-slate">Email</label>
                <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                <span asp-validation-for="Input.Email" class="text-danger typography-body-sm mt-1"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Input.FullName" class="typography-body-sm-medium mb-1 d-block text-slate">Họ và tên</label>
                <input asp-for="Input.FullName" class="form-control" autocomplete="name" aria-required="true" placeholder="Nguyễn Văn A" />
                <span asp-validation-for="Input.FullName" class="text-danger typography-body-sm mt-1"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Input.Address" class="typography-body-sm-medium mb-1 d-block text-slate">Địa chỉ</label>
                <input asp-for="Input.Address" class="form-control" autocomplete="address" aria-required="true" placeholder="Quận 1, TP.HCM" />
                <span asp-validation-for="Input.Address" class="text-danger typography-body-sm mt-1"></span>
            </div>
            
            <div class="mb-3">
                <label asp-for="Input.Password" class="typography-body-sm-medium mb-1 d-block text-slate">Mật khẩu</label>
                <input asp-for="Input.Password" class="form-control" autocomplete="new-password" aria-required="true" placeholder="••••••••" />
                <span asp-validation-for="Input.Password" class="text-danger typography-body-sm mt-1"></span>
            </div>

            <div class="mb-4">
                <label asp-for="Input.ConfirmPassword" class="typography-body-sm-medium mb-1 d-block text-slate">Xác nhận mật khẩu</label>
                <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" aria-required="true" placeholder="••••••••" />
                <span asp-validation-for="Input.ConfirmPassword" class="text-danger typography-body-sm mt-1"></span>
            </div>
            
            <button id="registerSubmit" type="submit" class="button-primary w-100 py-2 mb-3">Đăng ký ngay</button>
            
            <div class="text-center mt-4 pt-3 border-top" style="border-color: var(--color-hairline) !important;">
                <p class="typography-body-sm text-slate mb-0">
                    Đã có tài khoản? <a asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl" class="button-link fw-bold">Đăng nhập</a>
                </p>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
