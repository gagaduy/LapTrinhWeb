@model IEnumerable<Buoi6.Models.Category>

@{
    ViewData["Title"] = "Quản lý Danh mục";
}

<div class="mt-4 mb-5 container">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="typography-heading-2">Quản lý Danh mục</h1>
        <a asp-action="Create" class="button-primary">Thêm mới Danh mục</a>
    </div>

    <div class="card-base">
        <div class="table-responsive">
            <table class="table-notion">
                <thead>
                    <tr>
                        <th>Tên danh mục</th>
                        <th style="width: 200px;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
            @foreach (var item in Model) {
                    <tr>
                        <td class="fw-medium">@Html.DisplayFor(modelItem => item.Name)</td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@item.Id" class="button-ghost me-2">Sửa</a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="button-ghost text-danger">Xoá</a>
                        </td>
                    </tr>
            }
                </tbody>
            </table>
        </div>
    </div>
</div>
