@model IEnumerable<Buoi6.Models.Product>

@{
    ViewData["Title"] = "Quản lý Sản phẩm";
}

<div class="mt-4 mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="typography-heading-2">Quản lý Sản phẩm</h1>
        <a asp-action="Create" class="button-primary">Thêm mới Sản phẩm</a>
    </div>

    <div class="card-base">
        <div class="table-responsive">
            <table class="table-notion">
                <thead>
                    <tr>
                        <th>Tên sản phẩm</th>
                        <th>Giá</th>
                        <th>Hình ảnh</th>
                        <th>Danh mục</th>
                        <th>Thao tác</th>
                    </tr>
                </thead>
                <tbody>
            @foreach (var item in Model) {
                    <tr>
                        <td class="fw-medium">@Html.DisplayFor(modelItem => item.Name)</td>
                        <td style="color: var(--color-brand-orange-deep);">@item.Price.ToString("N0")</td>
                        <td>
                            <img src="@item.ImageUrl" style="width: 50px; height: 50px; border-radius: var(--rounded-md); object-fit: cover;" onerror="this.src='https://via.placeholder.com/50'"/>
                        </td>
                        <td>
                            <span class="badge" style="background: var(--color-card-tint-sky); color: var(--color-ink); border: 1px solid var(--color-hairline);">@Html.DisplayFor(modelItem => item.Category.Name)</span>
                        </td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@item.Id" class="button-ghost me-2">Sửa</a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="button-ghost text-danger">Xoá</a>
                        </td>
                    </tr>
            }
                </tbody>
            </table>
        </div>
    </div>
</div>
