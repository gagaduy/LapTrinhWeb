@model Buoi6.Models.Product

@{
    ViewData["Title"] = "Thêm mới Sản phẩm";
}

<div class="mt-4 mb-5 max-w-2xl mx-auto" style="max-width: 600px;">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="typography-heading-2">Thêm Sản phẩm mới</h1>
        <a asp-action="Index" class="button-secondary">Quay lại danh sách</a>
    </div>

    <div class="card-base">
        <form asp-action="Create" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            
            <div class="mb-4">
                <label asp-for="Name" class="typography-body-sm-medium mb-2 d-block text-slate"></label>
                <input asp-for="Name" class="form-control" placeholder="Nhập tên sản phẩm..." />
                <span asp-validation-for="Name" class="text-danger typography-body-sm mt-1"></span>
            </div>
            
            <div class="mb-4">
                <label asp-for="Price" class="typography-body-sm-medium mb-2 d-block text-slate"></label>
                <input asp-for="Price" class="form-control" placeholder="Ví dụ: 1000000" />
                <span asp-validation-for="Price" class="text-danger typography-body-sm mt-1"></span>
            </div>
            
            <div class="mb-4">
                <label asp-for="CategoryId" class="typography-body-sm-medium mb-2 d-block text-slate">Danh mục</label>
                <select asp-for="CategoryId" class="form-select" asp-items="ViewBag.Categories"></select>
            </div>
            
            <div class="mb-4">
                <label asp-for="Description" class="typography-body-sm-medium mb-2 d-block text-slate"></label>
                <textarea asp-for="Description" class="form-control" rows="4" placeholder="Mô tả chi tiết sản phẩm..."></textarea>
                <span asp-validation-for="Description" class="text-danger typography-body-sm mt-1"></span>
            </div>
            
            <div class="mb-4">
                <label asp-for="ImageUrl" class="typography-body-sm-medium mb-2 d-block text-slate">Hình ảnh</label>
                <input type="file" name="imageUrl" class="form-control" />
            </div>
            
            <div class="pt-3 border-top mt-4 text-end">
                <input type="submit" value="Tạo mới" class="button-primary" />
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
